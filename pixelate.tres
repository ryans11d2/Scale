[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform float Pixelate = 2.0;
uniform sampler2D screen_tex_frg_3 : hint_screen_texture;



void fragment() {
// Input:4
	vec2 n_out4p0 = UV;


// FloatParameter:6
	float n_out6p0 = Pixelate;


// VectorOp:9
	vec2 n_out9p0 = n_out4p0 * vec2(n_out6p0);


// VectorFunc:10
	vec2 n_out10p0 = round(n_out9p0);


// VectorOp:11
	vec2 n_out11p0 = n_out10p0 / vec2(n_out6p0);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(screen_tex_frg_3, n_out11p0);


// Output:0
	COLOR.rgb = vec3(n_out3p0.xyz);


}
